POSTGRES_DB=sknet_dev
POSTGRES_USER=sknet_dev
POSTGRES_PASSWORD=
WEB_PORT=5173
# Usa 0.0.0.0 para publicar el frontend en todas las interfaces de DEV.
WEB_BIND=127.0.0.1

# Opcional. El origen debe incluir el puerto y coincidir con la URL del navegador.
# SKNET_ORIGIN=http://127.0.0.1:5173
# SKNET_COOKIE_SECURE=0
# SKNET_SMTP_HOST=
# SKNET_SMTP_PORT=587
# SKNET_SMTP_FROM=
# SKNET_SMTP_USER=
# SKNET_SMTP_PASSWORD=

# Aprovisionamiento DEV. La vista previa de RouterOS se marca como simulación.
# SKNET_CONNECTIVITY_MODE=simulation
# SKNET_INSTALLATION_ID=sknet-dev
# SKNET_COLLECTOR_IMAGE=sknet-collector:dev
# SKNET_COLLECTOR_API_VOLUME=sknet-dev-collector-api
# SKNET_DOCKER_POOL=172.20.0.0/16
# SKNET_WG_POOL=10.200.1.0/24
# SKNET_PROTECTED_NETWORKS=
# SKNET_UDP_FIRST=51820
# SKNET_UDP_LAST=51919
# SKNET_UDP_INTERNAL=51820
# SKNET_UDP_BIND=127.0.0.1
# SKNET_WG_ENDPOINT=127.0.0.1
# SKNET_WG_MTU=1420
# SKNET_WG_KEEPALIVE=25
# SKNET_COLLECTOR_HEARTBEAT=10
# SKNET_COLLECTOR_STALE=30
